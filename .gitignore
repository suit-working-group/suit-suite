out/
*.aux
*.bcf
*.bbl
*.blg
*.run.xml
*.synctex.gz
*.log
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk

# OS / editor cruft
.DS_Store

# Per-developer Claude Code settings (machine-local, not part of the toolkit)
.claude/settings.local.json
