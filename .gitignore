# LaTeX build artifacts — temporary files live in out/, only the final .pdf
# (built next to its .tex) is tracked.
out/
*.aux
*.bcf
*.bbl
*.blg
*.run.xml
*.synctex.gz
*.log
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk

# Rendered instantiation editions are build outputs of each institution's set.tex
# — regenerable on demand, so not tracked (the wrapper .tex and set.tex are).
instantiations/*/render/*.pdf

# OS / editor cruft
.DS_Store

# Per-developer Claude Code settings (machine-local, not part of the toolkit)
.claude/settings.local.json
